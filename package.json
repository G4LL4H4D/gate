{
  "name": "opencode-gate",
  "version": "0.1.0",
  "description": "Concurrency gate for OpenCode: caps local-model subagents and reroutes overflow to a cloud model",
  "type": "module",
  "license": "MIT",
  "author": "Charles",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagent",
    "gate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G4LL4H4D/gate.git"
  },
  "homepage": "https://github.com/G4LL4H4D/gate#readme",
  "bugs": "https://github.com/G4LL4H4D/gate/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26",
    "@opentui/solid": "*",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.32",
    "typescript": "5.8.2",
    "@types/bun": "1.4.0",
    "solid-js": "1.9.15",
    "@opentui/solid": "0.5.17",
    "@opentui/core": "0.5.17"
  }
}
